# -----------------------------------------------------------------------------
# X402 AUTONOMOUS M2M ECOSYSTEM CONFIGURATION
# -----------------------------------------------------------------------------
# Expose only API keys and wallet addresses here. No human interaction required.

# Server Configuration
PORT=4020
NODE_ENV=production

# Crypto / Blockchain Settings
# Replace with your private EVM RPC endpoint (e.g., Alchemy, Infura, or local node)
RPC_ENDPOINT=https://polygon-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# The wallet address receiving the automated M2M payments
RECEIVER_WALLET_ADDRESS=0x0000000000000000000000000000000000000000

# Supported Token Contract (e.g., USDC on Polygon)
PAYMENT_TOKEN_ADDRESS=0x3c499c542cEF5E3811e1192ce70d8cC03d5c3359

# Base price per API call (e.g., 0.01 USDC)
PRICE_PER_CALL=0.01

# L2 Network ID (e.g., 137 for Polygon)
CHAIN_ID=137
